<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Markdown.UI.Desktop.ViewModels"
             x:Class="Markdown.UI.Desktop.Views.StatusBarView"
             x:DataType="vm:StatusBarViewModel">

    <Border Background="{DynamicResource StatusBarBackgroundBrush}"
            Height="22">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <!-- Cursor Position: Ln X, Col Y -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Margin="12,0,12,0"
                        VerticalAlignment="Center">
                <TextBlock Text="Ln "
                           Foreground="{DynamicResource StatusBarTextBrush}"
                           FontSize="12" />
                <TextBlock Text="{Binding Line}"
                           Foreground="{DynamicResource StatusBarTextBrush}"
                           FontSize="12" />
                <TextBlock Text=", Col "
                           Foreground="{DynamicResource StatusBarTextBrush}"
                           FontSize="12" />
                <TextBlock Text="{Binding Column}"
                           Foreground="{DynamicResource StatusBarTextBrush}"
                           FontSize="12" />
            </StackPanel>

            <!-- Separator -->
            <Border Grid.Column="1"
                    Width="1"
                    Background="{DynamicResource StatusBarTextBrush}"
                    Opacity="0.3"
                    Margin="0,4" />

            <!-- Total Lines -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Margin="12,0,12,0"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalLines}"
                           Foreground="{DynamicResource StatusBarTextBrush}"
                           FontSize="12" />
                <TextBlock Text=" lines"
                           Foreground="{DynamicResource StatusBarTextBrush}"
                           FontSize="12" />
            </StackPanel>

            <!-- Separator -->
            <Border Grid.Column="3"
                    Width="1"
                    Background="{DynamicResource StatusBarTextBrush}"
                    Opacity="0.3"
                    Margin="0,4" />

            <!-- Encoding -->
            <TextBlock Grid.Column="4"
                       Text="{Binding Encoding}"
                       Foreground="{DynamicResource StatusBarTextBrush}"
                       FontSize="12"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center" />

            <!-- Right-aligned items: Loading, Feedback, Auto-save status, and Modified indicator -->
            <StackPanel Grid.Column="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">

                <!-- Loading Indicator -->
                <StackPanel Orientation="Horizontal"
                            IsVisible="{Binding IsLoading}"
                            Margin="0,0,12,0">
                    <TextBlock Text="{Binding LoadingMessage}"
                               Foreground="{DynamicResource StatusBarTextBrush}"
                               FontSize="12"
                               FontStyle="Italic" />
                </StackPanel>

                <!-- Separator after loading indicator -->
                <Border Width="1"
                        Background="{DynamicResource StatusBarTextBrush}"
                        Opacity="0.3"
                        Margin="0,4,12,4"
                        IsVisible="{Binding IsLoading}" />

                <!-- Feedback Message (Success - white text) -->
                <TextBlock Text="{Binding FeedbackMessage}"
                           Foreground="{DynamicResource StatusBarTextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,12,0">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="HasFeedback" />
                            <Binding Path="!IsError" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>

                <!-- Feedback Message (Error - red text) -->
                <TextBlock Text="{Binding FeedbackMessage}"
                           Foreground="#FF6B6B"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,12,0">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="HasFeedback" />
                            <Binding Path="IsError" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>

                <!-- Separator after feedback -->
                <Border Width="1"
                        Background="{DynamicResource StatusBarTextBrush}"
                        Opacity="0.3"
                        Margin="0,4,12,4"
                        IsVisible="{Binding HasFeedback}" />

                <!-- Auto-save Status -->
                <TextBlock Text="{Binding AutoSaveStatus}"
                           Foreground="{DynamicResource StatusBarTextBrush}"
                           FontSize="12"
                           Margin="0,0,12,0" />

                <!-- Separator before modified indicator -->
                <Border Width="1"
                        Background="{DynamicResource StatusBarTextBrush}"
                        Opacity="0.3"
                        Margin="0,4,12,4"
                        IsVisible="{Binding IsModified}" />

                <!-- Modified Indicator -->
                <TextBlock Text="Modified"
                           Foreground="{DynamicResource StatusBarTextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           IsVisible="{Binding IsModified}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

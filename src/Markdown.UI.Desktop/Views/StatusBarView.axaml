<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Markdown.UI.Desktop.ViewModels"
             x:Class="Markdown.UI.Desktop.Views.StatusBarView"
             x:DataType="vm:StatusBarViewModel">

    <Border Background="{DynamicResource StatusBarBackgroundBrush}"
            Height="22">
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <!-- Cursor Position: Ln X, Col Y -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Margin="12,0,12,0"
                        VerticalAlignment="Center">
                <TextBlock Text="Ln "
                           Foreground="{DynamicResource StatusBarTextBrush}"
                           FontSize="12" />
                <TextBlock Text="{Binding Line}"
                           Foreground="{DynamicResource StatusBarTextBrush}"
                           FontSize="12" />
                <TextBlock Text=", Col "
                           Foreground="{DynamicResource StatusBarTextBrush}"
                           FontSize="12" />
                <TextBlock Text="{Binding Column}"
                           Foreground="{DynamicResource StatusBarTextBrush}"
                           FontSize="12" />
            </StackPanel>

            <!-- Separator -->
            <Border Grid.Column="1"
                    Width="1"
                    Background="{DynamicResource StatusBarTextBrush}"
                    Opacity="0.3"
                    Margin="0,4" />

            <!-- Total Lines -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Margin="12,0,12,0"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalLines}"
                           Foreground="{DynamicResource StatusBarTextBrush}"
                           FontSize="12" />
                <TextBlock Text=" lines"
                           Foreground="{DynamicResource StatusBarTextBrush}"
                           FontSize="12" />
            </StackPanel>

            <!-- Separator -->
            <Border Grid.Column="3"
                    Width="1"
                    Background="{DynamicResource StatusBarTextBrush}"
                    Opacity="0.3"
                    Margin="0,4" />

            <!-- Encoding -->
            <TextBlock Grid.Column="4"
                       Text="{Binding Encoding}"
                       Foreground="{DynamicResource StatusBarTextBrush}"
                       FontSize="12"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center" />

            <!-- Right-aligned items: Auto-save status and Modified indicator -->
            <StackPanel Grid.Column="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">

                <!-- Auto-save Status -->
                <TextBlock Text="{Binding AutoSaveStatus}"
                           Foreground="{DynamicResource StatusBarTextBrush}"
                           FontSize="12"
                           Margin="0,0,12,0" />

                <!-- Separator before modified indicator -->
                <Border Width="1"
                        Background="{DynamicResource StatusBarTextBrush}"
                        Opacity="0.3"
                        Margin="0,4,12,4"
                        IsVisible="{Binding IsModified}" />

                <!-- Modified Indicator -->
                <TextBlock Text="Modified"
                           Foreground="{DynamicResource StatusBarTextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           IsVisible="{Binding IsModified}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Markdown.UI.Desktop.ViewModels"
        xmlns:views="using:Markdown.UI.Desktop.Views"
        xmlns:converters="using:Markdown.UI.Desktop.Converters"
        x:Class="Markdown.UI.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Markdown Editor"
        MinWidth="800"
        MinHeight="600"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="30"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True" />
    </Window.Resources>

    <Window.Styles>
        <!-- Activity Bar button styles -->
        <Style Selector="Button.activity-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.activity-btn /template/ ContentPresenter">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.activity-btn PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource ActivityBarIconInactiveBrush}" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style Selector="Button.activity-btn:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.activity-btn:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource ActivityBarIconActiveBrush}" />
        </Style>
        <Style Selector="Button.activity-btn.active">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.activity-btn.active PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource ActivityBarIconActiveBrush}" />
        </Style>
        <!-- Title bar menu styles -->
        <Style Selector="Menu">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Menu > MenuItem">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}" />
        </Style>
        <Style Selector="Menu > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource TreeViewItemHoverBrush}" />
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewFileCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Alt+S" Command="{Binding SaveAllCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" />
        <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextTabCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousTabCommand}" />
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- Custom Title Bar -->
        <Panel DockPanel.Dock="Top">
            <!-- Background layer (fills entire area including off-screen portion) -->
            <Border Background="{DynamicResource TitleBarBackgroundBrush}"
                    IsHitTestVisible="False" />

            <!-- Content layer with offset -->
            <Grid RowDefinitions="Auto,Auto">
                <!-- Spacer for off-screen area when maximized -->
                <Border Grid.Row="0"
                        Height="{Binding $parent[Window].OffScreenMargin.Top}"
                        IsHitTestVisible="False" />

                <!-- Actual title bar content -->
                <Grid Grid.Row="1"
                      ColumnDefinitions="Auto,Auto,*,Auto"
                      Height="30">
                    <!-- App Icon -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <PathIcon Width="16"
                                  Height="16"
                                  Foreground="{DynamicResource TitleBarForegroundBrush}"
                                  Data="M9 3.5V11.5C9 11.776 8.776 12 8.5 12C8.224 12 8 11.776 8 11.5V4.831L5.376 7.83C5.187 8.048 4.814 8.048 4.624 7.83L2 4.831V11.5C2 11.776 1.776 12 1.5 12C1.224 12 1 11.776 1 11.5V3.5C1 3.292 1.129 3.105 1.324 3.032C1.521 2.96 1.74 3.014 1.876 3.171L5 6.741L8.124 3.171C8.261 3.014 8.478 2.959 8.676 3.032C8.871 3.105 9 3.292 9 3.5ZM14.854 9.146C14.659 8.951 14.342 8.951 14.147 9.146L13.001 10.292V3.5C13.001 3.224 12.777 3 12.501 3C12.225 3 12.001 3.224 12.001 3.5V10.293L10.855 9.147C10.66 8.952 10.343 8.952 10.148 9.147C9.953 9.342 9.953 9.659 10.148 9.854L12.148 11.854C12.246 11.952 12.757 11.952 12.855 11.854L14.855 9.854C15.05 9.659 15.05 9.342 14.855 9.147L14.854 9.146Z" />
                    </StackPanel>

                    <!-- Menu Bar -->
                    <Menu Grid.Column="1"
                          Margin="4,0,0,0"
                          VerticalAlignment="Center">
                        <MenuItem Header="_File">
                            <MenuItem Header="_New File"
                                      Command="{Binding NewFileCommand}"
                                      InputGesture="Ctrl+N" />
                            <Separator />
                            <MenuItem Header="_Open File..."
                                      Command="{Binding OpenFileCommand}"
                                      InputGesture="Ctrl+O" />
                            <MenuItem Header="Open _Folder..."
                                      Command="{Binding OpenFolderCommand}" />
                            <Separator />
                            <MenuItem Header="_Save"
                                      Command="{Binding SaveCommand}"
                                      InputGesture="Ctrl+S" />
                            <MenuItem Header="Save _As..."
                                      Command="{Binding SaveAsCommand}"
                                      InputGesture="Ctrl+Shift+S" />
                            <MenuItem Header="Save A_ll"
                                      Command="{Binding SaveAllCommand}"
                                      InputGesture="Ctrl+Shift+Alt+S" />
                            <Separator />
                            <MenuItem Header="E_xit"
                                      Command="{Binding ExitCommand}"
                                      InputGesture="Alt+F4" />
                        </MenuItem>

                        <MenuItem Header="_Edit">
                            <MenuItem Header="_Undo"
                                      Command="{Binding UndoCommand}"
                                      InputGesture="Ctrl+Z" />
                            <MenuItem Header="_Redo"
                                      Command="{Binding RedoCommand}"
                                      InputGesture="Ctrl+Y" />
                            <Separator />
                            <MenuItem Header="Cu_t"
                                      Command="{Binding CutCommand}"
                                      InputGesture="Ctrl+X" />
                            <MenuItem Header="_Copy"
                                      Command="{Binding CopyCommand}"
                                      InputGesture="Ctrl+C" />
                            <MenuItem Header="_Paste"
                                      Command="{Binding PasteCommand}"
                                      InputGesture="Ctrl+V" />
                        </MenuItem>
                    </Menu>

                    <!-- Window Title (centered) -->
                    <TextBlock Grid.Column="2"
                               x:CompileBindings="False"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource TitleBarForegroundBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               IsHitTestVisible="False" />

                    <!-- Spacer for system chrome buttons -->
                    <Border Grid.Column="3"
                            Width="138"
                            IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Panel>

        <!-- Bottom spacer for off-screen area when maximized -->
        <Border DockPanel.Dock="Bottom"
                Height="{Binding $parent[Window].OffScreenMargin.Bottom}"
                IsHitTestVisible="False" />

        <!-- Status Bar (Bottom) -->
        <views:StatusBarView DockPanel.Dock="Bottom"
                             DataContext="{Binding StatusBar}" />

        <!-- Main Content Area -->
        <Grid ColumnDefinitions="Auto,Auto,*">

            <!-- Activity Bar (Left) -->
            <Border Grid.Column="0"
                    Width="48"
                    Background="{DynamicResource ActivityBarBackgroundBrush}">
                <DockPanel>
                    <!-- Top buttons -->
                    <StackPanel DockPanel.Dock="Top">
                        <!-- Explorer Toggle Button -->
                        <Button Classes="activity-btn"
                                Classes.active="{Binding IsSidebarVisible}"
                                Command="{Binding ToggleSidebarCommand}"
                                ToolTip.Tip="Toggle Explorer (Ctrl+B)">
                            <PathIcon Width="24"
                                      Height="24"
                                      Data="M7.5 22.5H17.595C17.07 23.4 16.11 24 15 24H7.5C4.185 24 1.5 21.315 1.5 18V6C1.5 4.89 2.1 3.93 3 3.405V18C3 20.475 5.025 22.5 7.5 22.5ZM21 8.121V18C21 19.6545 19.6545 21 18 21H7.5C5.8455 21 4.5 19.6545 4.5 18V3C4.5 1.3455 5.8455 0 7.5 0H12.879C13.4715 0 14.0505 0.24 14.4705 0.6585L20.3415 6.5295C20.766 6.954 21 7.5195 21 8.121ZM13.5 6.75C13.5 7.164 13.8375 7.5 14.25 7.5H19.1895L13.5 1.8105V6.75ZM19.5 18V9H14.25C13.0095 9 12 7.9905 12 6.75V1.5H7.5C6.672 1.5 6 2.1735 6 3V18C6 18.8265 6.672 19.5 7.5 19.5H18C18.828 19.5 19.5 18.8265 19.5 18Z" />
                        </Button>
                    </StackPanel>

                    <!-- Bottom buttons -->
                    <StackPanel DockPanel.Dock="Bottom"
                                VerticalAlignment="Bottom">
                        <!-- Toggle Theme Button -->
                        <Button Classes="activity-btn"
                                Command="{Binding ToggleThemeCommand}"
                                ToolTip.Tip="Toggle Color Theme">
                            <PathIcon Width="24"
                                      Height="24"
                                      Data="M8 1.00195C6.61553 1.00195 5.26216 1.4125 4.11101 2.18167C2.95987 2.95084 2.06266 4.04409 1.53285 5.32317C1.00303 6.60225 0.86441 8.00972 1.13451 9.36759C1.4046 10.7255 2.07129 11.9727 3.05026 12.9517C4.02922 13.9307 5.27651 14.5974 6.63437 14.8675C7.99224 15.1375 9.3997 14.9989 10.6788 14.4691C11.9579 13.9393 13.0511 13.0421 13.8203 11.8909C14.5895 10.7398 15 9.38642 15 8.00195C15 6.14544 14.2625 4.36496 12.9498 3.05221C11.637 1.73945 9.85652 1.00195 8 1.00195ZM8 14.002V2.00195C9.5913 2.00195 11.1174 2.63409 12.2426 3.75931C13.3679 4.88453 14 6.41065 14 8.00195C14 9.59325 13.3679 11.1194 12.2426 12.2446C11.1174 13.3698 9.5913 14.002 8 14.002Z" />
                        </Button>
                    </StackPanel>

                    <!-- Spacer -->
                    <Border />
                </DockPanel>
            </Border>

            <!-- Primary Sidebar (File Explorer) -->
            <Grid Grid.Column="1"
                  x:Name="SidebarGrid"
                  IsVisible="{Binding IsSidebarVisible}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" MinWidth="150" MaxWidth="500" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- File Explorer -->
                <views:FileExplorerView Grid.Column="0"
                                        DataContext="{Binding FileExplorer}" />

                <!-- Resize Splitter -->
                <GridSplitter Grid.Column="1"
                              Width="4"
                              Background="{DynamicResource SplitterBrush}"
                              ResizeDirection="Columns" />
            </Grid>

            <!-- Main Editor Area -->
            <Grid Grid.Column="2"
                  RowDefinitions="Auto,*"
                  Background="{DynamicResource EditorBackgroundBrush}">

                <!-- Tab Bar - Always visible -->
                <views:TabBarView Grid.Row="0" />

                <!-- Editor Content Area -->
                <Grid Grid.Row="1">
                    <!-- Active Editor (when tabs exist) -->
                    <Border IsVisible="{Binding HasActiveTab}">
                        <views:EditorView DataContext="{Binding ActiveEditor}" />
                    </Border>

                    <!-- Empty State (when no tabs) -->
                    <Border IsVisible="{Binding !HasActiveTab}"
                            Background="{DynamicResource EditorBackgroundBrush}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="16">
                            <TextBlock Text="Markdown Editor"
                                       FontSize="32"
                                       FontWeight="Light"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" />

                            <StackPanel Spacing="8"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="Get started by:"
                                           FontSize="14"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" />

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="8">
                                    <TextBlock Text="Ctrl+N"
                                               FontSize="13"
                                               FontFamily="Cascadia Code, Consolas, monospace"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="New File"
                                               FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="8">
                                    <TextBlock Text="Ctrl+O"
                                               FontSize="13"
                                               FontFamily="Cascadia Code, Consolas, monospace"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="Open File"
                                               FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="8">
                                    <TextBlock Text="Ctrl+K O"
                                               FontSize="13"
                                               FontFamily="Cascadia Code, Consolas, monospace"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="Open Folder"
                                               FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Markdown.UI.Desktop.ViewModels"
        xmlns:views="using:Markdown.UI.Desktop.Views"
        xmlns:converters="using:Markdown.UI.Desktop.Converters"
        x:Class="Markdown.UI.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Markdown Editor"
        MinWidth="800"
        MinHeight="600"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="30"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True" />
    </Window.Resources>

    <Window.Styles>
        <!-- Activity Bar button styles -->
        <Style Selector="Button.activity-btn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Button.activity-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource TreeViewItemHoverBrush}" />
        </Style>
        <Style Selector="Button.activity-btn.active">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <!-- Title bar menu styles -->
        <Style Selector="Menu">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Menu > MenuItem">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TitleBarForegroundBrush}" />
        </Style>
        <Style Selector="Menu > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource TreeViewItemHoverBrush}" />
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewFileCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFileCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Alt+S" Command="{Binding SaveAllCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" />
        <KeyBinding Gesture="Ctrl+Tab" Command="{Binding NextTabCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Tab" Command="{Binding PreviousTabCommand}" />
        <KeyBinding Gesture="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- Custom Title Bar -->
        <Panel DockPanel.Dock="Top">
            <!-- Background layer (fills entire area including off-screen portion) -->
            <Border Background="{DynamicResource TitleBarBackgroundBrush}"
                    IsHitTestVisible="False" />

            <!-- Content layer with offset -->
            <Grid RowDefinitions="Auto,Auto">
                <!-- Spacer for off-screen area when maximized -->
                <Border Grid.Row="0"
                        Height="{Binding $parent[Window].OffScreenMargin.Top}"
                        IsHitTestVisible="False" />

                <!-- Actual title bar content -->
                <Grid Grid.Row="1"
                      ColumnDefinitions="Auto,Auto,*,Auto"
                      Height="30"
                      IsHitTestVisible="False">
                    <!-- App Icon -->
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <PathIcon Width="16"
                                  Height="16"
                                  Foreground="{DynamicResource TitleBarForegroundBrush}"
                                  Data="M3 3h18v18H3V3zm2 2v14h14V5H5zm2 2h10v2H7V7zm0 4h10v2H7v-2zm0 4h6v2H7v-2z" />
                    </StackPanel>

                    <!-- Menu Bar -->
                    <Menu Grid.Column="1"
                          Margin="4,0,0,0"
                          VerticalAlignment="Center"
                          IsHitTestVisible="True">
                        <MenuItem Header="_File">
                            <MenuItem Header="_New File"
                                      Command="{Binding NewFileCommand}"
                                      InputGesture="Ctrl+N" />
                            <Separator />
                            <MenuItem Header="_Open File..."
                                      Command="{Binding OpenFileCommand}"
                                      InputGesture="Ctrl+O" />
                            <MenuItem Header="Open _Folder..."
                                      Command="{Binding OpenFolderCommand}" />
                            <Separator />
                            <MenuItem Header="_Save"
                                      Command="{Binding SaveCommand}"
                                      InputGesture="Ctrl+S" />
                            <MenuItem Header="Save _As..."
                                      Command="{Binding SaveAsCommand}"
                                      InputGesture="Ctrl+Shift+S" />
                            <MenuItem Header="Save A_ll"
                                      Command="{Binding SaveAllCommand}"
                                      InputGesture="Ctrl+Shift+Alt+S" />
                            <Separator />
                            <MenuItem Header="E_xit"
                                      Command="{Binding ExitCommand}"
                                      InputGesture="Alt+F4" />
                        </MenuItem>

                        <MenuItem Header="_Edit">
                            <MenuItem Header="_Undo"
                                      Command="{Binding UndoCommand}"
                                      InputGesture="Ctrl+Z" />
                            <MenuItem Header="_Redo"
                                      Command="{Binding RedoCommand}"
                                      InputGesture="Ctrl+Y" />
                            <Separator />
                            <MenuItem Header="Cu_t"
                                      Command="{Binding CutCommand}"
                                      InputGesture="Ctrl+X" />
                            <MenuItem Header="_Copy"
                                      Command="{Binding CopyCommand}"
                                      InputGesture="Ctrl+C" />
                            <MenuItem Header="_Paste"
                                      Command="{Binding PasteCommand}"
                                      InputGesture="Ctrl+V" />
                        </MenuItem>
                    </Menu>

                    <!-- Window Title (centered) -->
                    <TextBlock Grid.Column="2"
                               x:CompileBindings="False"
                               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Foreground="{DynamicResource TitleBarForegroundBrush}"
                               FontSize="12"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               IsHitTestVisible="False" />

                    <!-- Spacer for system chrome buttons -->
                    <Border Grid.Column="3"
                            Width="138"
                            IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Panel>

        <!-- Status Bar (Bottom) -->
        <views:StatusBarView DockPanel.Dock="Bottom"
                             DataContext="{Binding StatusBar}" />

        <!-- Main Content Area -->
        <Grid ColumnDefinitions="Auto,Auto,*">

            <!-- Activity Bar (Left) -->
            <Border Grid.Column="0"
                    Width="48"
                    Background="{DynamicResource ActivityBarBackgroundBrush}">
                <StackPanel VerticalAlignment="Top">
                    <!-- Explorer Toggle Button -->
                    <Button Classes="activity-btn"
                            Classes.active="{Binding IsSidebarVisible}"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTip.Tip="Toggle Explorer (Ctrl+B)">
                        <PathIcon Width="24"
                                  Height="24"
                                  Foreground="{DynamicResource ForegroundBrush}"
                                  Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Primary Sidebar (File Explorer) -->
            <Grid Grid.Column="1"
                  x:Name="SidebarGrid"
                  IsVisible="{Binding IsSidebarVisible}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" MinWidth="150" MaxWidth="500" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- File Explorer -->
                <views:FileExplorerView Grid.Column="0"
                                        DataContext="{Binding FileExplorer}" />

                <!-- Resize Splitter -->
                <GridSplitter Grid.Column="1"
                              Width="4"
                              Background="{DynamicResource SplitterBrush}"
                              ResizeDirection="Columns" />
            </Grid>

            <!-- Main Editor Area -->
            <Grid Grid.Column="2"
                  RowDefinitions="Auto,*"
                  Background="{DynamicResource EditorBackgroundBrush}">

                <!-- Tab Bar - Always visible -->
                <views:TabBarView Grid.Row="0" />

                <!-- Editor Content Area -->
                <Grid Grid.Row="1">
                    <!-- Active Editor (when tabs exist) -->
                    <Border IsVisible="{Binding HasActiveTab}">
                        <views:EditorView DataContext="{Binding ActiveEditor}" />
                    </Border>

                    <!-- Empty State (when no tabs) -->
                    <Border IsVisible="{Binding !HasActiveTab}"
                            Background="{DynamicResource EditorBackgroundBrush}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="16">
                            <TextBlock Text="Markdown Editor"
                                       FontSize="32"
                                       FontWeight="Light"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" />

                            <StackPanel Spacing="8"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="Get started by:"
                                           FontSize="14"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           HorizontalAlignment="Center" />

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="8">
                                    <TextBlock Text="Ctrl+N"
                                               FontSize="13"
                                               FontFamily="Cascadia Code, Consolas, monospace"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="New File"
                                               FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="8">
                                    <TextBlock Text="Ctrl+O"
                                               FontSize="13"
                                               FontFamily="Cascadia Code, Consolas, monospace"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="Open File"
                                               FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Spacing="8">
                                    <TextBlock Text="Ctrl+K O"
                                               FontSize="13"
                                               FontFamily="Cascadia Code, Consolas, monospace"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="Open Folder"
                                               FontSize="13"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

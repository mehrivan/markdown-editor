<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Markdown.UI.Desktop.ViewModels"
             x:Class="Markdown.UI.Desktop.Views.TabBarView"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <!-- Tab item styles -->
        <Style Selector="Border.tab-item">
            <Setter Property="Background" Value="{DynamicResource TabBackgroundBrush}" />
        </Style>
        <Style Selector="Border.tab-item:pointerover">
            <Setter Property="Background" Value="{DynamicResource TabHoverBackgroundBrush}" />
        </Style>
        <Style Selector="Border.tab-item.active">
            <Setter Property="Background" Value="{DynamicResource TabActiveBackgroundBrush}" />
        </Style>
        <!-- Close button hover effect -->
        <Style Selector="Button.close-btn:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- DEBUG: Using bright colors to verify rendering -->
    <Border Background="#FF5500"
            Height="35">
        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="TabsItemsControl"
                          ItemsSource="{Binding Tabs}"
                          Background="#00FF00">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <!-- DEBUG: Simplified template to test if items render at all -->
                    <DataTemplate>
                        <Border Background="Red"
                                Width="120"
                                Height="30"
                                Margin="2">
                            <TextBlock Text="{Binding DisplayTitle, FallbackValue='NO BINDING'}"
                                       Foreground="White"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</UserControl>

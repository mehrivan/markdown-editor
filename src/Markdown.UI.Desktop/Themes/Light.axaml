<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Colors -->
    <!-- VS Code Light Theme inspired color palette -->

    <!-- Background Colors -->
    <Color x:Key="BackgroundColor">#FFFFFF</Color>
    <Color x:Key="SidebarBackgroundColor">#F3F3F3</Color>
    <Color x:Key="EditorBackgroundColor">#FFFFFF</Color>
    <Color x:Key="StatusBarBackgroundColor">#007ACC</Color>
    <Color x:Key="ActivityBarBackgroundColor">#E8E8E8</Color>

    <!-- Text Colors -->
    <Color x:Key="TextColor">#1E1E1E</Color>
    <Color x:Key="SecondaryTextColor">#6E6E6E</Color>
    <Color x:Key="StatusBarTextColor">#FFFFFF</Color>
    <Color x:Key="ActivityBarForegroundColor">#424242</Color>

    <!-- Accent Colors -->
    <Color x:Key="AccentColor">#007ACC</Color>
    <Color x:Key="AccentHoverColor">#1C97EA</Color>

    <!-- Tab Colors -->
    <Color x:Key="TabBackgroundColor">#ECECEC</Color>
    <Color x:Key="TabActiveBackgroundColor">#FFFFFF</Color>
    <Color x:Key="TabBorderColor">#E7E7E7</Color>
    <Color x:Key="TabHoverBackgroundColor">#E8E8E8</Color>

    <!-- Tree View / File Explorer Colors -->
    <Color x:Key="TreeViewItemHoverColor">#E8E8E8</Color>
    <Color x:Key="TreeViewItemSelectedColor">#CCE8FF</Color>

    <!-- Border Colors -->
    <Color x:Key="BorderColor">#E5E5E5</Color>
    <Color x:Key="SplitterColor">#E7E7E7</Color>

    <!-- Background Brushes -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="{StaticResource EditorBackgroundColor}" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="{StaticResource StatusBarBackgroundColor}" />
    <SolidColorBrush x:Key="ActivityBarBackgroundBrush" Color="{StaticResource ActivityBarBackgroundColor}" />

    <!-- Text Brushes -->
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="StatusBarTextBrush" Color="{StaticResource StatusBarTextColor}" />
    <SolidColorBrush x:Key="ActivityBarForegroundBrush" Color="{StaticResource ActivityBarForegroundColor}" />

    <!-- Accent Brushes -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />

    <!-- Tab Brushes -->
    <SolidColorBrush x:Key="TabBackgroundBrush" Color="{StaticResource TabBackgroundColor}" />
    <SolidColorBrush x:Key="TabActiveBackgroundBrush" Color="{StaticResource TabActiveBackgroundColor}" />
    <SolidColorBrush x:Key="TabBorderBrush" Color="{StaticResource TabBorderColor}" />
    <SolidColorBrush x:Key="TabHoverBackgroundBrush" Color="{StaticResource TabHoverBackgroundColor}" />

    <!-- Tree View / File Explorer Brushes -->
    <SolidColorBrush x:Key="TreeViewItemHoverBrush" Color="{StaticResource TreeViewItemHoverColor}" />
    <SolidColorBrush x:Key="TreeViewItemSelectedBrush" Color="{StaticResource TreeViewItemSelectedColor}" />

    <!-- Border Brushes -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SplitterBrush" Color="{StaticResource SplitterColor}" />

</ResourceDictionary>
